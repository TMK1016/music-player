{
  "version": "v0.6.0",
  "selected_solution": "A",
  "solutions": [
    {
      "id": "A",
      "title": "合成頻率響應估算餘裕",
      "status": "已實作",
      "detail": "計算整組 EQ 與低架濾波在各頻率的疊加增益，取最大正增益加 3 dB 餘裕；殘響非零混合仍保留額外 6 dB。先修正衰減過量，不改變音樂動態。",
      "tradeoff": "屬模型估算，不是樣本峰值或 true-peak 保證；仍可能比原音小聲，沒有精確響度補償。"
    },
    {
      "id": "B",
      "title": "EQ 前後響度補償",
      "status": "待後續選擇",
      "detail": "量測或分析音訊響度差，加入穩定、平滑的補償，讓聽感更接近。",
      "tradeoff": "需要處理靜音、曲目切換、低頻佔比與補償上限；過快調整可能抽動，不應追逐每個音符。"
    },
    {
      "id": "C",
      "title": "輸出峰值限制器",
      "status": "待後續選擇",
      "detail": "處理超出門檻的瞬間峰值，與適量補償搭配。",
      "tradeoff": "需驗證攻擊／釋放、前視延遲、峰值與失真；介入過多會改變動態，不能稱完全透明。"
    },
    {
      "id": "D",
      "title": "歌曲響度正規化",
      "status": "待後續選擇",
      "detail": "離線分析曲目響度，平衡不同歌曲的播放音量。",
      "tradeoff": "解決歌曲之間的差異，不能單獨取代 EQ 前後補償或輸出峰值保護。"
    }
  ],
