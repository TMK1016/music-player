    {
      "id": "release-0-2",
      "version": "v0.2.0",
      "date": "2026-10-24",
      "title": "本機播放與原生等化器",
      "summary": "從介面原型進入能匯入、離線播放與調整 EQ 的本機版本；Rust、iPhone 真機與實車仍待驗證。",
      "changes": [
        {
          "id": "local-import",
          "title": "本機匯入與離線音樂庫",
          "summary": "複製原始音檔、SHA-256 去重、原子索引與損毀保護；不搬走使用者檔案。",
          "node_ids": [
            "LIB-01"
          ],
          "target_page": "library",
          "locations": [
            {
              "path": "apps/apple/OrcaPlayer/LibraryStore.swift",
              "label": "LibraryStore.swift"
            },
            {
              "path": "apps/apple/OrcaPlayer/LibraryView.swift",
              "label": "LibraryView.swift"
            }
          ]
        },
        {
          "id": "local-playback",
          "title": "實際播放與定位",
          "summary": "接入 Apple 音訊引擎，支援暫停、恢復、進度、切歌、隨機與整份循環。",
          "node_ids": [
            "PLAY-01",
            "SPIKE-01"
          ],
          "target_page": "player",
          "locations": [
            {
              "path": "apps/apple/OrcaPlayer/AudioPlayback.swift",
              "label": "AudioPlayback.swift"
            },
            {
              "path": "apps/apple/OrcaPlayer/PlayerModel.swift",
              "label": "PlayerModel.swift"
            }
          ]
        },
        {
          "id": "native-eq",
          "title": "真正作用於音訊的 10 段 EQ",
          "summary": "原生固定頻段 EQ、前級補償、預設與旁通；並非 Rust、逐喇叭 DSP 或量測響應。",
          "node_ids": [
            "EQ-01"
          ],
          "target_page": "equalizer",
          "locations": [
            {
              "path": "apps/apple/OrcaPlayer/AudioPlayback.swift",
              "label": "AudioPlayback.swift"
            },
            {
              "path": "apps/apple/OrcaPlayer/EqualizerView.swift",
              "label": "EqualizerView.swift"
            }
          ]
        },
        {
          "id": "native-audio-checks",
          "title": "匯入、播放狀態與 PCM 驗證",
          "summary": "完成離線副本、去重、尾曲與循環狀態檢查；原生離線 PCM 的 1kHz +6dB 設定測得 +6.00dB。",
          "node_ids": [
            "QA-01"
          ],
          "target_page": null,
